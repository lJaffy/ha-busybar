#!/command/with-contenv bashio
# ==============================================================================
# emulator (longrun): the headless BUSY Bar server itself.
# Binds 127.0.0.1 only (upstream HOST constant); relay-api exposes it on the
# container network, and the BUSY mobile app / busy-hacs reach it via the
# mapped host port.
# ==============================================================================
# shellcheck disable=SC1091

PORT="${EMU_PORT:-$(cat /run/busy-emulator/port 2>/dev/null)}"
FIRMWARE="${EMU_FIRMWARE:-$(cat /run/busy-emulator/firmware 2>/dev/null)}"
: "${PORT:?EMU_PORT unset: init-emulator must run first}"
: "${FIRMWARE:?EMU_FIRMWARE unset: init-emulator must run first}"

# Leave a trace even if node dies silently: the emulator buffers all startup
# output until it is ready, so a hang mid-startup otherwise prints nothing.
bashio::log.info "Starting emulator: node $(node --version), port=${PORT} firmware=${FIRMWARE} data=/data/emulator"

# The app's log_level maps onto the emulator's --verbose (prints where a
# failed start failed); trace/debug enable it. log_level defaults to info
# in config.yaml so this read always succeeds.
VERBOSE=()
case "$(bashio::config 'log_level')" in
    trace|debug) VERBOSE=(--verbose) ;;
esac

# shellcheck disable=SC2086
exec node /opt/busy-emulator/server/index.mjs \
    --port "${PORT}" \
    --data /data/emulator \
    --firmware "${FIRMWARE}" \
    ${VERBOSE[@]+"${VERBOSE[@]}"}
