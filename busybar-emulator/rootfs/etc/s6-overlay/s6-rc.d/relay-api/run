#!/command/with-contenv bashio
# ==============================================================================
# relay-api (longrun): expose the emulator's 127.0.0.1-only listener on the
# container network so LAN clients (BUSY mobile app, busy-hacs) can reach it.
#
# A plain TCP forward is NOT enough: the emulator's entry guard
# (entry-guard.mjs) admits only requests whose Host header is
# 127.0.0.1:<port> or localhost:<port> and answers anything else with 403.
# busy-relay rewrites Host to 127.0.0.1:<port> before forwarding; bodies and
# WebSocket upgrades (state stream) pass through untouched.
# ==============================================================================
# shellcheck disable=SC1091

PORT="${EMU_PORT:-$(cat /run/busy-emulator/port 2>/dev/null)}"
: "${PORT:?EMU_PORT unset: init-emulator must run first}"

for _ in $(seq 1 60); do
    if (echo > /dev/tcp/127.0.0.1/"${PORT}") >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

bashio::log.info "Relaying 0.0.0.0:${PORT} -> 127.0.0.1:${PORT} (Host rewritten)"
exec python3 /usr/bin/busy-relay "${PORT}" "${PORT}"
