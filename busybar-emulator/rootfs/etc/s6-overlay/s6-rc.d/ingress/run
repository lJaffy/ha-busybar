#!/command/with-contenv bashio
# ==============================================================================
# ingress (longrun): nginx on 8099 serving the /emulator window through
# Home Assistant ingress. Supervisor-only access (see ingress.conf).
# ==============================================================================
# shellcheck disable=SC1091

# nginx opens its compiled-in default error log (prefix/logs/error.log)
# before parsing nginx.conf, so also point it at stderr here; the config
# file repeats the setting for nginx -T and any child re-execs.
mkdir -p /run/nginx
exec nginx -e stderr -c /etc/nginx/nginx.conf -g "daemon off;"
