server {
    listen 8099 default_server;

    # Ingress: only the Supervisor talks to this port (172.30.32.2).
    allow 172.30.32.2;
    deny all;

    # proxy_set_header Host: the emulator's entry guard admits only
    # Host 127.0.0.1:<port>/localhost:<port>, even from localhost.
    set $emu 127.0.0.1:__EMU_INT_PORT__;

    # Flat window UI under ingress. The emulator's page uses absolute asset
    # paths (/emulator/*, /_nuxt/*) which resolve against the ingress prefix,
    # so the page is served from the root here and sub_filter rewrites them
    # to relative URLs that stay under /api/hassio_ingress/<token>/.
    #
    # Framing: the emulator answers frame-ancestors 'none' + X-Frame-Options
    # SAMEORIGIN (correct for direct access: its window must not be embedded
    # by other origins). But the HA sidebar loads this page in an iframe from
    # the HA origin — same-origin through ingress, yet 'none' forbids even
    # that, so Firefox refuses to load it. Strip the upstream framing headers
    # here, at the Supervisor-only ingress proxy, and re-assert SAMEORIGIN:
    # through ingress the page IS same-origin, direct access keeps the
    # emulator's own headers untouched.
    location / {
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Frame-Options;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        add_header X-Frame-Options "SAMEORIGIN" always;

        sub_filter_once off;
        sub_filter 'href="/emulator/' 'href="./emulator/';
        sub_filter 'src="/emulator/' 'src="./emulator/';
        sub_filter 'href="/_nuxt/' 'href="./_nuxt/';
        sub_filter 'src="/_nuxt/' 'src="./_nuxt/';
        sub_filter '"/api/' '"./api/';
        sub_filter "'/api/" "'./api/";

        proxy_pass http://127.0.0.1:__EMU_INT_PORT__/emulator;
        proxy_set_header Host $emu;
        proxy_set_header X-Forwarded-For 172.30.32.2;
        proxy_set_header X-Ingress-Path $http_x_ingress_path;
    }

    # State stream and any nested API calls the window makes.
    location /api/ {
        proxy_pass http://127.0.0.1:__EMU_INT_PORT__;
        proxy_set_header Host $emu;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
    }

    location /_nuxt/ {
        proxy_pass http://127.0.0.1:__EMU_INT_PORT__;
        proxy_set_header Host $emu;
    }

    location /emulator/ {
        proxy_pass http://127.0.0.1:__EMU_INT_PORT__;
        proxy_set_header Host $emu;
    }
}
